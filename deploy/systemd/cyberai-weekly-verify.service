[Unit]
Description=CyberAI weekly verify pipeline (H + J1+J2+J3 + J5 + Slack)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/cyberai
EnvironmentFile=/root/cyberai/.env
Environment=PATH=/root/cyberai/.venv/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/bash /root/cyberai/scripts/weekly_pipeline.sh
StandardOutput=append:/var/log/cyberai-weekly.log
StandardError=append:/var/log/cyberai-weekly.log
TimeoutStartSec=6h
